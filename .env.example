# Claude API key for the built-in agent. Leave empty to hide the agent.
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional agent tuning
# AGENT_MODEL=claude-opus-5-5
# AGENT_EFFORT=medium        # low | medium | high | xhigh | max

# Set to true only if the hub is reachable exclusively through Cloudflare
# (Tunnel or proxied DNS with no open port). Requests without the Cloudflare
# Access identity header are rejected.
REQUIRE_CF_ACCESS=false

# Docker network shared with Nginx Proxy Manager (used by docker-compose.yml)
PROXY_NETWORK=npm_default

# Status checks
# STATUS_TIMEOUT_MS=5000
# STATUS_CACHE_MS=20000
